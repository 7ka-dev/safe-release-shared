{
  "name": "safe-release-shared",
  "version": "0.1.0",
  "description": "Общий код клиента и сервера Safe Release: Colyseus Schema, константы правил, DTO",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "watch": "tsc -p tsconfig.esm.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}